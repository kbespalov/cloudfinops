# Cloud.ru Foundation Models (OpenAI-compatible) API key.
# Used server-side only by /api/chat for the AI assistant.
# Default model: google/gemini-3.1-flash-lite (override with CLOUDRU_FM_MODEL).
# Copy this file to .env.local and paste your Cloud.ru key. NEVER commit real keys.
# Do NOT point CLOUDRU_FM_* at Nebius Token Factory for local prod-like chat.
CLOUDRU_FM_API_KEY=

# Optional overrides (defaults shown):
# CLOUDRU_FM_BASE_URL=https://foundation-models.api.cloud.ru/v1
# CLOUDRU_FM_MODEL=google/gemini-3.1-flash-lite
# CLOUDRU_FM_EMBEDDING_MODEL=BAAI/bge-m3
#
# Chat FastPath sampling. Default 0 = full LLM-only on /chat
# (no chips/aliases/helpers, no deterministic post-tool markdown, no regex
# inference/lakehouse gates). Calculator surface always on.
# Set 0.2 / 1 for FastPath A/B. LLM-only raises token reservation for rate limits.
# CHAT_FAST_PATH_PROBABILITY=0
#
# Ambiguous block-disk vs Object Storage intent (extra flash-lite hop).
# off (default) | shadow (log only) | on (override planning cards/addendum).
# Only runs when regex intent is both/none+storage-ish — not on every turn.
# CHAT_STORAGE_INTENT_LLM=shadow
#
# Precompute catalog embeddings for hybrid search_prices (optional, needs API key):
#   npm run data:build && npm run data:embeddings
# Offline retrieval eval (lexical vs hybrid):
#   npm run eval:retrieval

# IndexNow (SEO) — push new/updated URLs to Yandex & Bing after deploy.
# Run: npm run seo:indexnow  (see scripts/indexnow.ts)
# The key file must be live at https://<host>/<INDEXNOW_KEY>.txt (committed in public/).
# SITE_URL=https://cloudfinops.ru
# INDEXNOW_KEY=d340d6f02d0606daf4eaff3243aa7dd0
# INDEXNOW_ONLY=/news/<id>   # optional: ping only specific changed URLs
